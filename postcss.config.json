{
    "plugins": [
        "postcss-flexbugs-fixes",
        [
            "@csstools/postcss-global-data",
            {
                "files": ["./src/styles/media.css"]
            }
        ],
        "postcss-nested",
        "postcss-custom-media",
        [
            "postcss-preset-env",
            {
                "autoprefixer": {
                    "flexbox": "no-2009"
                },
                "stage": 3,
                "features": {
                    "custom-properties": false
                }
            }
        ]
    ]
}
